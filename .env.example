# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------
# Configuração do Bot-fig (WhatsApp Figurinhas com Som)
# ----------------------------------------------------------------

# Números que podem usar o bot (DDI + DDD + número, só dígitos), separados por vírgula.
# Vazio = qualquer pessoa que mandar mensagem ao número do bot.
# 0 = só você (comandos enviados pela própria conta do bot).
ALLOWED_NUMBERS=0

# Para conectar com CÓDIGO em vez de QR: seu número com 55 + DDD, só dígitos.
# Ex.: 5511999998888. Vazio = usa QR code.
NUMERO_CONEXAO=

# Nome que aparece ao tocar na figurinha (nome do pacote) e autor (opcional).
STICKER_PACK_NAME=Criada por Dexter
STICKER_PUBLISHER=

# Pasta onde fica a sessão do WhatsApp (equivale a estar logado: não compartilhe).
AUTH_DIR=./sessao

# Porta da página local que mostra o QR quando rodado via CLI standalone.
QR_PORT=3999

# Quantos pedidos podem esperar na fila ao mesmo tempo.
MAX_PENDING=5

# Caminho do FFmpeg/ffprobe, se não estiverem no PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# true = mostra cada mensagem recebida e o tempo de cada etapa.
DEBUG=false

# silent | warn | info | debug — logs internos do Baileys.
LOG_LEVEL=silent
